# Copy to .env (never commit .env). All values are examples/placeholders.

# Muse Spark (brain) — OpenAI SDK against Meta Model API. Never use -contributor variants.
MODEL_API_KEY=LLM|000000000000000|replace-me
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
# Voice latency: Spark's invisible reasoning dominates TTFT (~700 tokens at
# default vs ~75 at minimal, measured). minimal|low|medium|high|xhigh|max.
MODEL_REASONING_EFFORT=minimal

# Muse Voice Transcribe — WebSocket only (streaming STT with diarization).
# Exact WS URL comes from your Meta Model API voice docs/cookbook for your account.
MUSE_VT_WS_URL=wss://api.meta.ai/v1/replace-with-voice-transcribe-ws-path
MUSE_VT_MODEL=muse-voice-transcribe-1.0
# Speaker label that counts as the owner; anything else/ambiguous -> stranger (REQ-42).
OWNER_SPEAKER_LABEL=speaker_0

# VoxCPM2 TTS (Ticket 003) — pinned vLLM-Omni endpoint on Akash.
# Agent-side only: the key must never reach the browser, SDL commits, or logs.
# Leave unset for the proven text-only loop. Both must be set together.
TTS_BASE_URL=https://replace-with-provider-uri.example
TTS_API_KEY=[REDACTED]
TTS_MODEL=openbmb/VoxCPM2
# Spark-authored Voice Design description and seed (recorded in docs/voice.md).
TTS_VOICE_DESCRIPTION=replace-with-spark-authored-voice-description
TTS_SEED=42

# LiveKit (transport). Local: `livekit-server --dev` or LiveKit Cloud.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me-local-dev-secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
