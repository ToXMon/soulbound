# Template for `docker compose` (the credentialed local stack). Placeholders only.
# Do NOT copy this by hand: run ./scripts/init-compose-env.sh, which writes .env
# (gitignored, mode 0600) with freshly generated LiveKit and operator secrets.
# The three generated values are left empty here on purpose, so a stack can never
# start with a secret that is published in this repository.

# --- Generated by scripts/init-compose-env.sh (do not hand-edit or share) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEMO_ACCESS_USER=operator
DEMO_ACCESS_PASSWORD=

# --- Required: Meta Model API key (Muse Spark + Voice Transcribe + SAM). ---
# Never a -contributor model for personal content.
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3
# MODEL_REASONING_EFFORT=minimal
# MUSE_VT_WS_URL=wss://api.meta.ai/v1/asr/realtime
# MUSE_VT_MODEL=muse-voice-transcribe-1.0

# --- Optional: spoken replies (VoxCPM2 on your own GPU host). ---
# Leave TTS_BASE_URL and TTS_API_KEY empty for text-only replies. To get a voice, set
# all three of TTS_BASE_URL, TTS_API_KEY and TTS_VOICE_DESCRIPTION (see docs/voice.md).
# The endpoint must be https:// and is yours to provision (akash/deploy.yml, docs/003).
TTS_BASE_URL=
TTS_API_KEY=
# Candidate A from docs/voice.md (selection still pending): a warm, youthful voice, gentle and curious, clear and natural at a relaxed pace
TTS_VOICE_DESCRIPTION=
# TTS_MODEL=openbmb/VoxCPM2
# TTS_SEED=42

# --- Optional: durable memory (on by default, stored in the soulbound-data volume). ---
# MEMORY_ENABLED=true
# MEMORY_OWNER_ID=judge-demo
# MEMORY_CHARACTER_ID=warden
