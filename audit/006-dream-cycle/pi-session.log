ocess.argv.slice(2)) {"}, {"oldText": "      await access(join(root, namespaceDirName(ns), \"store.json\")); // never create an empty store silently\n      const store = await MemoryStore.open(root, ns);\n      try {\n        // Copy a consistent validated graph, then release the voice store before slow inference.\n        memories = store.records.map((m: DreamMemory) => ({ id: m.id, content_hash: m.content_hash, summary: m.summary, timestamp: m.timestamp,\n          ...(m.supersedes ? { supersedes: m.supersedes } : {}) }));\n      } finally { await store.close(); }", "newText": "      memories = await readMemoryGraph(root, ns); // never create, lock, or modify the voice store"}]}

