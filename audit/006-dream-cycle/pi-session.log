pub lifecycle_checks: Vec<(HookableLifecycleEvent, ExternalCheckResult)>,
pub enum HookableLifecycleEvent {
    Create,
    Transfer,
    Burn,
    Update,
}
pub struct ExternalCheckResult {
    pub flags: u32,
}
