{"schema_version":1,"id":"01a181db-7061-7110-af60-094e8d31f77b","stream":{"kind":"session","id":"01a181d8-3e87-7443-9e82-2e8d47650f48"},"sequence":827,"recorded_at":1793180004449267,"record_type":"event","durability":"durable","causation_id":null,"payload_type":"runtime.session","payload_schema_version":1,"payload":{"event":{"kind":"assistant_tool_calls_committed","message_id":"d7397f3f-bb82-47b1-9aa1-cd07057e294e","response_id":"resp_6ae1c160cd2f0a8bd0104288","tool_calls":[{"args":"{\"path\":\"agent/src/pipeline.ts\",\"content\":\"// pipeline: observe -> orient -> decide -> act for one diarized turn.\\nimport { resolveSpeaker, type DiarizedTurn } from \\\"./orient.js\\\";\\nimport { decide } from \\\"./decide.js\\\";\\nimport { act, type TurnRecord } from \\\"./act.js\\\";\\n\\nexport async function runTurn(turn: DiarizedTurn, sttMs = 0): Promise<TurnRecord> {\\n  const kind = resolveSpeaker(turn);\\n  const reply = await decide(turn, kind);\\n  return act(turn, kind, reply, sttMs);\\n}\\n\"}","call_id":"call_01a181db622d77a5bf85869a64cfb523","id":"fc_01a181db622d77a5bf85869a64cfb523","name":"write_file"},{"args":"{\"path\":\"agent/scripts/latency-harness.ts\",\"content\":\"// REQ-40 latency harness: scripted 20-turn run through orient -> decide -> act.\\n// The STT leg needs a live Muse VT WebSocket + LiveKit room, so scripted turns\\n// enter at the transcript boundary; sttMs is therefore 0 and labeled as such.\\n// No mocks: without MODEL_API_KEY every turn fails loudly and the run is BLOCKED.\\nimport { writeFileSync, mkdirSync } from \\\"node:fs\\\";\\nimport { dirname } from \\\"node:path\\\";\\nimport { runTurn } from \\\"../src/pipeline.ts\\\";\\nimport type { DiarizedTurn } from \\\"../src/orient.ts\\\";\\n\\nconst args = process.argv.slice(2);\\nconst turns = Number(args[args.indexOf(\\\"--turns\\\") + 1] ?? 20);\\nconst out = args[args.indexOf(\\\"--out\\\") + 1] ?? \\\"verify.txt\\\";\\n\\nconst SCRIPT: DiarizedTurn[] = [\\n  { speaker: \\\"speaker_0\\\", text: \\\"Hello, are you there?\\\" },\\n  { speaker: \\\"speaker_0\\\", text: \\\"What should I call you?\\\" },\\n  { speaker: null, text: \\\"Hi, I just walked up.\\\" }, // diarization ambiguous -> stranger (REQ-42)\\n  { speaker: \\\"speaker_1\\\", text: \\\"Hello, new voice here.\\\" },\\n  { speaker: \\\"speaker_0\\\", text: \\\"Tell me something you are curious about.\\\" },\\n];\\n\\nconst lines: string[] = [\\n  `REQ-40 latency harness — ${new Date().toISOString()}`,\\n  `turns requested: ${turns}`,\\n  \\\"stt leg: not exercised by scripted run (needs live Muse VT WS + LiveKit room); sttMs=0, totals are Spark-decide latency only\\\",\\n];\\nconst lat: number[] = [];\\nlet diarizedCount = 0;\\nlet failures = 0;\\n\\nfor (let i = 0; i < turns; i++) {\\n  const turn = SCRIPT[i % SCRIPT.length];\\n  try {\\n    const rec = await runTurn(turn, 0);\\n    lat.push(rec.sttToReplyMs);\\n    if (rec.diarized) diarizedCount++;\\n    lines.push(`turn ${i + 1}: diarized=${rec.diarized} speaker=${rec.speaker ?? \\\"?\\\"} kind=${rec.kind} stt->reply=${rec.sttToReplyMs}ms model=${rec.model} reply=\\\"${rec.reply.slice(0, 80)}\\\"`);\\n  } catch (err) {\\n    failures++;\\n    lines.push(`turn ${i + 1}: FAILED ${(err as Error).message}`);\\n  }\\n}\\n\\nif (lat.length) {\\n  const sorted = [...lat].sort((a, b) => a - b);\\n  const p50 = sorted[Math.floor(sorted.length / 2)];\\n  lines.push(`completed: ${lat.length}/${turns} diarized: ${diarizedCount} p50 stt->reply (decide-only): ${p50}ms`);\\n}\\nlines.push(failures ? `RESULT: BLOCKED — ${failures} turn(s) failed; see above. Live VT/LiveKit legs unverified.` : \\\"RESULT: decide leg OK; VT + LiveKit legs unverified by this scripted run.\\\");\\n\\nmkdirSync(dirname(out), { recursive: true });\\nwriteFileSync(out, lines.join(\\\"\\\\n\\\") + \\\"\\\\n\\\");\\nconsole.log(lines.join(\\\"\\\\n\\\"));\\nif (failures) process.exitCode = 1;\\n\"}","call_id":"call_01a181db63807700b122d9dde6c2d095","id":"fc_01a181db63807700b122d9dde6c2d095","name":"write_file"}]},"kind":"run","run_id":"01a181d9-de31-70b2-80c6-58ffe0a281a4","source_run_record_id":"4fbb2bcb-f67c-44c6-a391-5a7cbff25c27","source_run_record_sequence":323}}
