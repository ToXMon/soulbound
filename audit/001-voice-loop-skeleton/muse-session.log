{"schema_version":1,"id":"01a181db-5071-7383-844f-8701cb241c70","stream":{"kind":"session","id":"01a181d8-3e87-7443-9e82-2e8d47650f48"},"sequence":675,"recorded_at":1793179996273879,"record_type":"event","durability":"durable","causation_id":null,"payload_type":"runtime.session","payload_schema_version":1,"payload":{"event":{"kind":"assistant_tool_calls_committed","message_id":"979294bd-c7a8-42fd-a8c9-9cce23f8cc41","response_id":"resp_6ae1c1533845d7c472954f63","tool_calls":[{"args":"{\"path\":\"agent/package.json\",\"content\":\"{\\n  \\\"name\\\": \\\"agent\\\",\\n  \\\"private\\\": true,\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"start\\\": \\\"node dist/index.js\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@livekit/agents\\\": \\\"^0.7.0\\\",\\n    \\\"openai\\\": \\\"^4.104.0\\\"\\n  },\\n  \\\"devDependencies\\\": {\\n    \\\"@types/node\\\": \\\"^22.0.0\\\",\\n    \\\"typescript\\\": \\\"^5.9.0\\\"\\n  }\\n}\\n\"}","call_id":"call_01a181db323b770a9172faa05fce6277","id":"fc_01a181db323b770a9172faa05fce6277","name":"write_file"},{"args":"{\"path\":\"agent/tsconfig.json\",\"content\":\"{\\n  \\\"compilerOptions\\\": {\\n    \\\"target\\\": \\\"ES2022\\\",\\n    \\\"module\\\": \\\"NodeNext\\\",\\n    \\\"moduleResolution\\\": \\\"NodeNext\\\",\\n    \\\"outDir\\\": \\\"dist\\\",\\n    \\\"rootDir\\\": \\\".\\\",\\n    \\\"strict\\\": true,\\n    \\\"skipLibCheck\\\": true,\\n    \\\"types\\\": [\\\"node\\\"]\\n  },\\n  \\\"include\\\": [\\\"src/**/*.ts\\\", \\\"scripts/**/*.ts\\\"]\\n}\\n\"}","call_id":"call_01a181db348672c68070d538c7b0cfd8","id":"fc_01a181db348672c68070d538c7b0cfd8","name":"write_file"},{"args":"{\"path\":\"agent/src/orient.ts\",\"content\":\"// orient: stable persona prefix (prompt-caching) + speaker resolution.\\n// REQ-42: diarization-off / ambiguous attribution degrades to stranger, never to silence.\\n\\nexport const PERSONA_PREFIX = `You are the SOULBOUND character, a persistent companion meeting people through voice. This is a placeholder persona for the voice-loop skeleton: be warm, brief (one to three sentences), and curious. If you are told you are speaking with a stranger, greet them as a new voice meeting you for the first time. Never claim capabilities you do not have in this skeleton: you can listen and reply in text.`;\\n\\nexport type SpeakerKind = \\\"owner\\\" | \\\"stranger\\\";\\n\\nexport interface DiarizedTurn {\\n  speaker: string | null;\\n  text: string;\\n  confidence?: number;\\n}\\n\\nexport function resolveSpeaker(turn: DiarizedTurn): SpeakerKind {\\n  const owner = process.env.OWNER_SPEAKER_LABEL ?? \\\"speaker_0\\\";\\n  if (!turn.speaker || turn.confidence !== undefined && turn.confidence < 0.5) return \\\"stranger\\\";\\n  return turn.speaker === owner ? \\\"owner\\\" : \\\"stranger\\\";\\n}\\n\\nexport function systemPrompt(kind: SpeakerKind): string {\\n  const who = kind === \\\"owner\\\"\\n    ? \\\"You are speaking with your owner.\\\"\\n    : \\\"You are speaking with a stranger, a new voice. Greet them as such.\\\";\\n  return `${PERSONA_PREFIX}\\\\n${who}`;\\n}\\n\"}","call_id":"call_01a181db360a74e49afccf3e53ea5508","id":"fc_01a181db360a74e49afccf3e53ea5508","name":"write_file"},{"args":"{\"path\":\"agent/src/decide.ts\",\"content\":\"// decide: Muse Spark via the OpenAI SDK against the Meta Model API.\\n// Model purity: muse-spark-1.3 only; never a -contributor variant.\\nimport OpenAI from \\\"openai\\\";\\nimport { systemPrompt, type DiarizedTurn, type SpeakerKind } from \\\"./orient.js\\\";\\n\\nexport interface TurnReply {\\n  text: string;\\n  model: string;\\n  latencyMs: number;\\n}\\n\\nlet client: OpenAI | null = null;\\n\\nfunction spark(): OpenAI {\\n  const apiKey = process.env.MODEL_API_KEY;\\n  if (!apiKey) throw new Error(\\\"MODEL_API_KEY is not set (see .env.example)\\\");\\n  client ??= new OpenAI({\\n    apiKey,\\n    baseURL: process.env.MODEL_API_BASE_URL ?? \\\"https://api.meta.ai/v1\\\",\\n  });\\n  return client;\\n}\\n\\nexport async function decide(turn: DiarizedTurn, kind: SpeakerKind): Promise<TurnReply> {\\n  const model = process.env.MODEL_NAME ?? \\\"muse-spark-1.3\\\";\\n  if (model.includes(\\\"contributor\\\")) throw new Error(`refusing contributor-tier model: ${model}`);\\n  const t0 = performance.now();\\n  const res = await spark().chat.completions.create({\\n    model,\\n    messages: [\\n      { role: \\\"system\\\", content: systemPrompt(kind) },\\n      { role: \\\"user\\\", content: turn.text },\\n    ],\\n  });\\n  const text = res.choices[0]?.message?.content?.trim();\\n  if (!text) throw new Error(\\\"Spark returned an empty reply\\\");\\n  return { text, model: res.model ?? model, latencyMs: performance.now() - t0 };\\n}\\n\"}","call_id":"call_01a181db3cf970dfb1774c69410fd24d","id":"fc_01a181db3cf970dfb1774c69410fd24d","name":"write_file"},{"args":"{\"path\":\"agent/src/observe.ts\",\"content\":\"// observe: Muse Voice Transcribe over WebSocket only (never HTTP for streaming).\\n// Receives diarized turns; emits final turns to the handler. No mock fallback:\\n// missing config or a dropped socket is a loud error, per evidence honesty.\\nimport type { DiarizedTurn } from \\\"./orient.js\\\";\\n\\ninterface VtMessage {\\n  type?: string;\\n  speaker?: string | null;\\n  text?: string;\\n  transcript?: string;\\n  confidence?: number;\\n  is_final?: boolean;\\n}\\n\\nexport class VoiceTranscribeStream {\\n  private ws: WebSocket | null = null;\\n\\n  constructor(private onTurn: (turn: DiarizedTurn) => void) {}\\n\\n  async connect(): Promise<void> {\\n    const url = process.env.MUSE_VT_WS_URL;\\n    const apiKey = process.env.MODEL_API_KEY;\\n    if (!url) throw new Error(\\\"MUSE_VT_WS_URL is not set (see .env.example)\\\");\\n    if (!apiKey) throw new Error(\\\"MODEL_API_KEY is not set (see .env.example)\\\");\\n    const ws = new WebSocket(url, {\\n      headers: { Authorization: `Bearer ${apiKey}` },\\n    } as unknown as string[]);\\n    this.ws = ws;\\n    await new Promise<void>((resolve, reject) => {\\n      ws.addEventListener(\\\"open\\\", () => resolve(), { once: true });\\n      ws.addEventListener(\\\"error\\\", () => reject(new Error(\\\"Muse VT WebSocket failed to open\\\")), { once: true });\\n    });\\n    ws.send(JSON.stringify({\\n      type: \\\"session.config\\\",\\n      model: process.env.MUSE_VT_MODEL ?? \\\"muse-voice-transcribe-1.0\\\",\\n      diarization: true,\\n      format: \\\"pcm_s16le\\\",\\n      sample_rate_hz: 16000,\\n    }));\\n    ws.addEventListener(\\\"message\\\", (ev: MessageEvent) => {\\n      let msg: VtMessage;\\n      try { msg = JSON.parse(String(ev.data)) as VtMessage; } catch { return; }\\n      const text = msg.text ?? msg.transcript;\\n      if (!text || msg.is_final === false) return;\\n      this.onTurn({ speaker: msg.speaker ?? null, text, confidence: msg.confidence });\\n    });\\n    ws.addEventListener(\\\"close\\\", () => { this.ws = null; });\\n  }\\n\\n  sendAudio(pcm: Buffer | Uint8Array): void {\\n    if (!this.ws || this.ws.readyState !== WebSocket.OPEN) return;\\n    this.ws.send(JSON.stringify({ type: \\\"audio\\\", data: Buffer.from(pcm).toString(\\\"base64\\\") }));\\n  }\\n\\n  close(): void { this.ws?.close(); this.ws = null; }\\n}\\n\"}","call_id":"call_01a181db411572ad9d4e2df6d5c28698","id":"fc_01a181db411572ad9d4e2df6d5c28698","name":"write_file"},{"args":"{\"path\":\"agent/src/act.ts\",\"content\":\"// act: render the reply (UI data channel / log) + per-turn latency record (REQ-40).\\nimport type { DiarizedTurn, SpeakerKind } from \\\"./orient.js\\\";\\nimport type { TurnReply } from \\\"./decide.js\\\";\\n\\nexport interface TurnRecord {\\n  diarized: boolean;\\n  speaker: string | null;\\n  kind: SpeakerKind;\\n  transcript: string;\\n  reply: string;\\n  model: string;\\n  sttToReplyMs: number;\\n}\\n\\nexport function act(turn: DiarizedTurn, kind: SpeakerKind, reply: TurnReply, sttMs: number): TurnRecord {\\n  const rec: TurnRecord = {\\n    diarized: turn.speaker !== null,\\n    speaker: turn.speaker,\\n    kind,\\n    transcript: turn.text,\\n    reply: reply.text,\\n    model: reply.model,\\n    sttToReplyMs: Math.round(sttMs + reply.latencyMs),\\n  };\\n  console.log(`[turn] diarized=${rec.diarized} speaker=${rec.speaker ?? \\\"?\\\"} kind=${kind} stt->reply=${rec.sttToReplyMs}ms model=${rec.model}`);\\n  console.log(`[turn] user: ${rec.transcript}`);\\n  console.log(`[turn] reply: ${rec.reply}`);\\n  return rec;\\n}\\n\"}","call_id":"call_01a181db491b77e4a0057f6ce7859934","id":"fc_01a181db491b77e4a0057f6ce7859934","name":"write_file"}]},"kind":"run","run_id":"01a181d9-de31-70b2-80c6-58ffe0a281a4","source_run_record_id":"f119e9ba-b605-45b3-af71-2631bc0671f1","source_run_record_sequence":268}}
