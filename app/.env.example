# Local development only; these are PUBLIC LiveKit --dev credentials.
# Never expose this server or these credentials on a public interface.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880
DEMO_ROOM=soulbound

# Server-only loopback proof service. No signing keys in the app environment.
LIFE_READ_URL=http://127.0.0.1:8787

# Hosted production requires HTTPS/WSS and operator admission.
# Generate your own password of at least 24 characters; never commit it.
# DEMO_ACCESS_USER=operator
# DEMO_ACCESS_PASSWORD=
