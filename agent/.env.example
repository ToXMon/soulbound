# Copy to agent/.env (never commit agent/.env). Placeholders only.

# Muse Spark (brain) — OpenAI SDK against Meta Model API. Never -contributor variants.
# META_API_KEY (the Muse Code credential name) is accepted as a fallback.
MODEL_API_KEY=LLM|000000000000000|replace-me
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Muse Voice Transcribe — WebSocket only, cookbook protocol (observe.ts).
MUSE_VT_WS_URL=wss://api.meta.ai/v1/asr/realtime
MUSE_VT_MODEL=muse-voice-transcribe-1.0
MUSE_VT_ENCODING=PCM_16KHZ
# Owner speaker: a bare diarization letter ("A", "B", ...). When unset, the
# first diarized speaker letter seen in a session becomes the owner (REQ-42);
# any other letter or no label is treated as a stranger.
OWNER_SPEAKER_LABEL=

# LiveKit (transport). Local: `livekit-server --dev` or LiveKit Cloud.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me-local-dev-secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Ticket 004 durable memory (opt-in). When MEMORY_ENABLED=true, all three of
# STORE_PATH / OWNER_ID / CHARACTER_ID are required or startup fails loudly.
# Store path is private local storage — never commit its contents.
MEMORY_ENABLED=false
MEMORY_STORE_PATH=
MEMORY_OWNER_ID=
MEMORY_CHARACTER_ID=
MEMORY_QUEUE_CAPACITY=16
MEMORY_JOB_TIMEOUT_MS=30000

# Ticket 005: standalone operator CLI ONLY, never read by the voice worker.
# Owner must be an actual Solana public key; character ID a canonical decimal u64.
# No alias mapping (e.g. char-elder). Configure real sessions with the same identity.
MEMORY_COMMIT_RPC_URL=https://api.devnet.solana.com
MEMORY_COMMIT_PROGRAM_ID=BdswGigVwzuRjcbj2XMsNHTGB37pCaPQquq8v1tAqJZd
MEMORY_COMMIT_RUNTIME_PUBLIC_KEY=
MEMORY_COMMIT_FEE_PAYER=
# Absolute private paths outside the repository. Files 0600, directory 0700.
MEMORY_COMMIT_JOURNAL=
MEMORY_COMMIT_RUNTIME_KEY_FILE=
MEMORY_COMMIT_FEE_PAYER_KEY_FILE=

# Ticket 005 amendment: explicit operator rotation, never automatic.
# Replacement key is created/stored on Tolu's Mac ONLY; public address may be shared.
# Owner key reference must point to secure local storage after separately approved remediation.
MEMORY_ROTATE_EXPECTED_RUNTIME_PUBLIC_KEY=
MEMORY_ROTATE_REPLACEMENT_PUBLIC_KEY=
MEMORY_ROTATE_OWNER_KEY_FILE=
MEMORY_ROTATE_REPLACEMENT_KEY_FILE=
MEMORY_ROTATE_JOURNAL=
