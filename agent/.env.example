# Copy to agent/.env (never commit agent/.env). Placeholders only.

# Muse Spark (brain) — OpenAI SDK against Meta Model API. Never -contributor variants.
# META_API_KEY (the Muse Code credential name) is accepted as a fallback.
MODEL_API_KEY=LLM|000000000000000|replace-me
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Muse Voice Transcribe — WebSocket only, cookbook protocol (observe.ts).
MUSE_VT_WS_URL=wss://api.meta.ai/v1/asr/realtime
MUSE_VT_MODEL=muse-voice-transcribe-1.0
MUSE_VT_ENCODING=PCM_16KHZ
# Owner speaker: a bare diarization letter ("A", "B", ...). When unset, the
# first diarized speaker letter seen in a session becomes the owner (REQ-42);
# any other letter or no label is treated as a stranger.
OWNER_SPEAKER_LABEL=

# LiveKit (transport). Local: `livekit-server --dev` or LiveKit Cloud.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me-local-dev-secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Ticket 004 durable memory (opt-in). When MEMORY_ENABLED=true, all three of
# STORE_PATH / OWNER_ID / CHARACTER_ID are required or startup fails loudly.
# Store path is private local storage — never commit its contents.
MEMORY_ENABLED=false
MEMORY_STORE_PATH=
MEMORY_OWNER_ID=
MEMORY_CHARACTER_ID=
MEMORY_QUEUE_CAPACITY=16
MEMORY_JOB_TIMEOUT_MS=30000
